	column Decade
		dataType: string
		lineageTag: 733d6ccf-ea46-596c-94f5-5ef5f318b4f1
		summarizeBy: none
		sourceColumn: [Decade]

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				ADDCOLUMNS (
				    CALENDAR (
				        DATE ( YEAR ( MIN ( 'Housing Data'[Sale Date] ) ), 1, 1 ),
				        MAX ( 'Housing Data'[Sale Date] )
				    ),
				    "Year", YEAR ( [Date] ),
				    "Quarter Number", QUARTER ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Year-Quarter", YEAR ( [Date] ) & " Q" & QUARTER ( [Date] ),
				    "Year-Quarter Sort", YEAR ( [Date] ) * 10 + QUARTER ( [Date] ),
				    "Quarter Start", DATE ( YEAR ( [Date] ), ( QUARTER ( [Date] ) - 1 ) * 3 + 1, 1 ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm", "en-US" ),
				    "Month Start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "Decade", FLOOR ( YEAR ( [Date] ), 10 ) & "s"
				)

